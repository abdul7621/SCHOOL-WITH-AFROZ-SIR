# ==========================================
# 7A School ERP SaaS Platform Configuration
# ==========================================

# Environment Mode: development, staging, production
ENVIRONMENT=development
DEBUG=True
PLATFORM_DOMAIN=7aedu.com
ADMIN_DOMAIN=admin.7aedu.com

# SaaS Control Database Configuration
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_USER=root
CONTROL_DB_PASSWORD=your_secure_mysql_password
CONTROL_DB_NAME=saas_control_db

# Default MySQL Root/Admin for Tenant DB Provisioning (Used strictly by provisioning service)
TENANT_MYSQL_HOST=127.0.0.1
TENANT_MYSQL_PORT=3306
TENANT_MYSQL_ADMIN_USER=root
TENANT_MYSQL_ADMIN_PASSWORD=your_secure_mysql_password

# Redis Configuration (Used for cache, session tokens, and Celery broker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_INDEX=0
REDIS_PASSWORD=

# JWT Secrets & Security
JWT_SECRET_KEY=change_this_to_a_super_secret_64_character_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Super Admin Initial Credentials (Used on initial bootstrap)
INITIAL_SUPER_ADMIN_EMAIL=superadmin@7aedu.com
INITIAL_SUPER_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_SUPER_ADMIN_NAME="Platform Super Admin"

# File Storage Configuration (local or s3)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/var/www/school_erp/storage/tenants
# For S3 / Cloudflare R2 / Backblaze B2 (when enabled):
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=auto

# Celery Broker / Result URLs
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
